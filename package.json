{
  "name": "wayfare",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": "22.x"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.1"
  },
  "scripts": {
    "dev": "pnpm --filter @wayfare/web dev",
    "dev:web": "pnpm --filter @wayfare/web dev",
    "dev:mobile": "pnpm --filter @wayfare/mobile start",
    "web": "pnpm --filter @wayfare/web dev",
    "mobile": "pnpm --filter @wayfare/mobile start",
    "mobile:ios": "pnpm --filter @wayfare/mobile ios",
    "build": "pnpm --filter @wayfare/web build",
    "lint": "pnpm -r --if-present run lint",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm --filter @wayfare/domain test && pnpm --filter @wayfare/map-preferences test && pnpm --filter @wayfare/web test && pnpm --filter @wayfare/mobile test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "release:check": "node scripts/release-readiness.mjs all",
    "release:check:web": "node scripts/release-readiness.mjs web",
    "release:check:mobile": "node scripts/release-readiness.mjs mobile",
    "release:check:database": "node scripts/release-readiness.mjs database"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "vitest": "^4.0.18"
  }
}
