{
  "name": "wayfare",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.1"
  },
  "overrides": {
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.1"
  },
  "scripts": {
    "dev": "npm run dev --workspace=@wayfare/web",
    "dev:web": "npm run dev --workspace=@wayfare/web",
    "dev:mobile": "npm run start --workspace=@wayfare/mobile",
    "web": "npm run dev --workspace=@wayfare/web",
    "mobile": "npm run start --workspace=@wayfare/mobile",
    "mobile:ios": "npm run ios --workspace=@wayfare/mobile",
    "build": "npm run build --workspace=@wayfare/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspace=@wayfare/domain && npm run test --workspace=@wayfare/web && npm run test --workspace=@wayfare/mobile",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "vitest": "^4.0.18"
  }
}
