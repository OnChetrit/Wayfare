# Public values only. Do not put service-role, Google Places server, or database keys here.
EXPO_PUBLIC_WEB_URL=https://your-wayfare-web.example
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Restricted native Maps keys: iOS bundle ID and Android package/signing certificate respectively.
EXPO_PUBLIC_GOOGLE_MAPS_IOS_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_KEY=
