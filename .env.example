# Browser-safe web configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-browser-restricted-maps-key
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=your-google-map-id

# Server-only integrations; never expose these through NEXT_PUBLIC_* or EXPO_PUBLIC_*
GOOGLE_MAPS_SERVER_API_KEY=your-server-restricted-maps-key
AERODATABOX_API_KEY=your-rapidapi-key
AERODATABOX_API_HOST=aerodatabox.p.rapidapi.com
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase CLI only; not required by the running application
SUPABASE_DB_PASSWORD=your-database-password
